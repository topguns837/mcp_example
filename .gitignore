# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# local_client.py's redirected server-side error log
notes_server.log

# docker compose env overrides
.env

# IDE specific files
.vscode/

# Local Ollama model cache (bind-mounted into the ollama container at
# /root/.ollama, downloaded at runtime by startScript.sh -- track the
# folder itself so it exists after a fresh clone, but never its contents).
/ollama-data/*
!/ollama-data/.gitkeep
