# Copy this to .env -- docker compose reads it automatically.

# Model the `app` container's local_client.py uses, and that `start.sh`
# pulls into the `ollama` service on first run. ~1GB, good tool-calling
# support for this server's two simple tools.
OLLAMA_MODEL=qwen2.5:1.5b
# Even lighter alternative (~1.3GB, faster, slightly less reliable at
# multi-step tool calling): OLLAMA_MODEL=llama3.2:1b

# Host port Ollama's API is exposed on, for curl/debugging outside Docker.
OLLAMA_PORT=11434
